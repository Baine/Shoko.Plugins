<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Shoko.Plugin.MovieMissingFilter</AssemblyName>
    <RootNamespace>Shoko.Plugin.MovieMissingFilter</RootNamespace>
    <Version>0.12.0</Version>
    <Authors>MovieMissingFilter</Authors>
    <Description>Configurable runtime enhancement for Shoko Missing Episodes with independent E/S/O visibility, redundant movie-layout suppression, and aligned dashboard/series-detail counters without modifying Shoko or its database.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <AssemblyMetadata Include="PackageID" Value="4e525337-8c50-4bd2-a8ec-feb3f202d9f7" />
    <AssemblyMetadata Include="PackageName" Value="Movie Missing Filter" />
    <AssemblyMetadata Include="PackageOverview" Value="Configurable Missing Episodes filter with independent Normal (E), Special (S), and Other (O) visibility, redundant movie-layout suppression, and aligned counters without modifying Shoko or its database." />
    <AssemblyMetadata Include="PackageTags" Value="missing-episodes,movie,anidb" />
    <PackageReference Include="Shoko.Abstractions" Version="6.0.0-alpha.81" ExcludeAssets="runtime" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>
</Project>
