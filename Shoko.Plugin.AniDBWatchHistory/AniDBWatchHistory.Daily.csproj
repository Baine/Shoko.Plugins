<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Shoko.Plugin.AniDBWatchHistory</AssemblyName>
    <RootNamespace>Shoko.Plugin.AniDBWatchHistory</RootNamespace>
    <Version>1.0.7</Version>
    <Authors>Fioon</Authors>
    <Description>Imports watched dates from an AniDB MyList XML export into Shoko Daily.</Description>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Shoko.Abstractions" Version="6.0.0-alpha.98"
                      ExcludeAssets="runtime" />
    <PackageReference Include="Shoko.BuildTools.Targets" Version="0.3.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web/index.html" />
    <AssemblyMetadata Include="PackageID" Value="0d89b27b-d4e7-4e60-97ca-696a59f9fd5e" />
    <AssemblyMetadata Include="PackageName" Value="AniDB Watch History Import" />
    <AssemblyMetadata Include="PackageOverview" Value="Imports watched dates from AniDB MyList XML into Shoko's configured AniDB user." />
    <AssemblyMetadata Include="PackageTags" Value="anidb,watch-history,import" />
  </ItemGroup>

</Project>
