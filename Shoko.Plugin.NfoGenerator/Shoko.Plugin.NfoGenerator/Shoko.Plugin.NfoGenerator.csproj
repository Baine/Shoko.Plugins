<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Shoko.Plugin.NfoGenerator</RootNamespace>
    <AssemblyName>Shoko.Plugin.NfoGenerator</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>Baine</Authors>
    <RepositoryUrl>https://github.com/Baine/Shoko.Plugins</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NfoGenerator.SelfCheck" />
  </ItemGroup>

  <!-- Embedded identity metadata that Shoko reads at plugin load time. -->
  <ItemGroup>
    <AssemblyMetadata Include="PackageID" Value="5c5482c1-3dd0-49cb-b862-d57e305da353" />
    <AssemblyMetadata Include="PackageName" Value="NFO Generator" />
    <AssemblyMetadata Include="PackageOverview" Value="Generates Kodi-style NFO files and artwork sidecars next to your video files whenever a release is matched by Shoko." />
    <AssemblyMetadata Include="RuntimeIdentifier" Value="$(RuntimeIdentifier)" Condition="'$(RuntimeIdentifier)' != ''" />
    <AssemblyMetadata Include="ReleaseChannel" Value="$(RELEASE_CHANNEL)" Condition="'$(RELEASE_CHANNEL)' != ''" />
  </ItemGroup>

  <!-- Git provenance stamped at build time. Mirrors ShokoRelay's approach. -->
  <Target Name="StampGitMetadata" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo" Condition="Exists('$(MSBuildProjectDirectory)\..\..\.git')">
    <PropertyGroup Condition="$(OS) == 'Windows_NT'">
      <GitDateFormat>%%aI</GitDateFormat>
      <NullStdErr>NUL</NullStdErr>
    </PropertyGroup>
    <PropertyGroup Condition="$(OS) != 'Windows_NT'">
      <GitDateFormat>%aI</GitDateFormat>
      <NullStdErr>/dev/null</NullStdErr>
    </PropertyGroup>
    <Exec Command="git log -1 --format=$(GitDateFormat)" ConsoleToMsBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitAuthorDateRaw" />
    </Exec>
    <Exec Command="git rev-parse HEAD" ConsoleToMsBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitRaw" />
    </Exec>
    <Exec Command="git describe --exact-match --tags --match &quot;nfo-generator/v[0-9]*.[0-9]*.[0-9]*&quot; --match &quot;v[0-9]*.[0-9]*.[0-9]*&quot; 2>$(NullStdErr)" ConsoleToMsBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitTagRaw" />
    </Exec>
    <PropertyGroup>
      <ReleaseDate>$([System.String]::Copy('$(_GitAuthorDateRaw)').Trim())</ReleaseDate>
      <SourceRevision>$([System.String]::Copy('$(_GitCommitRaw)').Trim())</SourceRevision>
      <ReleaseTag>$([System.String]::Copy('$(_GitTagRaw)').Trim())</ReleaseTag>
      <Version Condition="'$(_GitTagRaw)' != ''">$([System.String]::Copy('$(_GitTagRaw)').Trim().Replace('nfo-generator/v','').TrimStart('v'))</Version>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="ReleaseDate" Value="$(ReleaseDate)" Condition="'$(ReleaseDate)' != ''" />
      <AssemblyMetadata Include="SourceRevision" Value="$(SourceRevision)" Condition="'$(SourceRevision)' != ''" />
      <AssemblyMetadata Include="ReleaseTag" Value="$(ReleaseTag)" Condition="'$(ReleaseTag)' != ''" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Shoko.Abstractions" Version="6.0.0-alpha.77" ExcludeAssets="runtime" />
    <PackageReference Include="Shoko.QueueProcessor" Version="6.0.0-alpha.6" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
